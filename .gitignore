# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/
/dev-*-check*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated character asset archive
/public/maso/phases-50-svg.zip

# local tool settings (Claude Code など。ローカルのパスや許可設定を含む)
/.claude/

# Supabase CLI local state (supabase link で作られるプロジェクト情報)
/supabase/.temp/
/supabase/.branches/

# keys and certificates (*.pem は上で除外済み)
*.key
*.p12
*.pfx

# logs
*.log

# editor / OS files (OneDrive は desktop.ini を作る)
.idea/
.vscode/
Thumbs.db
desktop.ini
